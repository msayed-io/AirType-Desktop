<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LiveTypeBridge</AssemblyName>
    <RootNamespace>LiveTypeBridge.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>LiveTypeBridge.App.Program</StartupObject>
    <Version>1.0.0</Version>
    <Product>LiveType Bridge</Product>
    <Authors>LiveType Bridge</Authors>
    <SatelliteResourceLanguages>ar;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveTypeBridge.Core\LiveTypeBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
