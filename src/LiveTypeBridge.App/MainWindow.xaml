<Window x:Class="LiveTypeBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiveType Bridge"
        Width="500" Height="640"
        MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="14"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgBrush}" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrushKey}"
                    BorderThickness="0,0,0,1" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <Ellipse Width="11" Height="11" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppTitle}" Margin="8,0,0,0"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}" Margin="12,0,0,0"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleBarButton}"
                                Content="{DynamicResource LangToggle}"
                                Width="72"
                                Command="{Binding ToggleLanguageCommand}"
                                ToolTip="عربي / English"/>
                        <Button Style="{StaticResource TitleBarButton}"
                                Content="—" Click="Minimize_Click"
                                ToolTip="{DynamicResource WinMin}"/>
                        <Button Style="{StaticResource TitleBarButton}"
                                Content="✕" Click="Close_Click"
                                ToolTip="{DynamicResource WinClose}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nav + content -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,6,0,0">
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsHome, Mode=OneWay}"
                                 Command="{Binding NavCommand}" CommandParameter="home"
                                 Content="{DynamicResource NavHome}"/>
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsSettings, Mode=OneWay}"
                                 Command="{Binding NavCommand}" CommandParameter="settings"
                                 Content="{DynamicResource NavSettings}"/>
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsDiagnostics, Mode=OneWay}"
                                 Command="{Binding NavCommand}" CommandParameter="diag"
                                 Content="{DynamicResource NavDiagnostics}"/>

                    <TextBlock Text="{Binding HotkeyWarning}"
                               Style="{StaticResource Caption}" Margin="10,16,6,0"
                               Foreground="{DynamicResource WarnBrush}"
                               Visibility="{Binding HasHotkeyWarning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="Transparent">
                    <ContentControl Content="{Binding CurrentPage}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
