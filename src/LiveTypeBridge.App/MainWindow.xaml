<Window x:Class="LiveTypeBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirType" Width="900" Height="650" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FlowDirection="RightToLeft" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="22" UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgBrush}" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- Floating functional layer: independent capsules, never a full-width toolbar. -->
            <Grid Grid.Row="0" Margin="18,12">
                <Border Style="{StaticResource GlassCapsule}" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="13,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource CyanBrush}" Margin="0,0,9,0"/>
                        <TextBlock Text="AirType" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="  •  local, private, instant" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCapsule}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource TitleBarButton}" Content="{DynamicResource LangToggle}" Width="66" Command="{Binding ToggleLanguageCommand}" ToolTip="عربي / English"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click" ToolTip="{DynamicResource WinMin}"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click" ToolTip="{DynamicResource WinClose}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="22,0,22,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,8,22,0">
                    <TextBlock Text="{DynamicResource AppSubtitle}" Style="{StaticResource Caption}" Margin="8,0,8,18"/>
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="home" Content="{DynamicResource NavHome}"/>
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="settings" Content="{DynamicResource NavSettings}"/>
                    <RadioButton Style="{StaticResource NavItem}" IsChecked="{Binding IsDiagnostics, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="diag" Content="{DynamicResource NavDiagnostics}"/>
                    <Border Style="{StaticResource GlassCapsule}" Margin="0,24,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="AIR / TYPE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{DynamicResource PrivacyTagline}" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding HotkeyWarning}" Style="{StaticResource Caption}" Margin="8,14,6,0" Foreground="{DynamicResource WarnBrush}" Visibility="{Binding HasHotkeyWarning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="Transparent">
                    <ContentControl Content="{Binding CurrentPage}"/>
                </Border>
            </Grid>

            <Border x:Name="UpdateBanner" Grid.Row="1" Margin="24,10,24,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Style="{StaticResource WarnCard}" Visibility="Collapsed" Panel.ZIndex="20">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="{DynamicResource UpdateTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/><TextBlock x:Name="UpdateMessage" Style="{StaticResource Caption}"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UpdateInstallButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource UpdateInstall}" Click="UpdateInstall_Click" Margin="0,0,6,0"/><Button Content="{DynamicResource UpdateLater}" Click="UpdateLater_Click"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
