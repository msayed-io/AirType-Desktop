<Window x:Class="LiveTypeBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirType" Width="900" Height="650" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FlowDirection="RightToLeft" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="22" UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgBrush}" CornerRadius="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="78"/>
            </Grid.RowDefinitions>

            <!-- Two exact-height pills: their 22px radius is half their 44px height. -->
            <Grid Grid.Row="0" Margin="20,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border Style="{StaticResource GlassCapsule}" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource CyanBrush}" Margin="0,0,9,0"/>
                        <TextBlock Text="AirType" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="  •  local, private, instant" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GlassCapsule}" Height="44" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="5,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Content="◉" Width="38" Click="FloatingToggle_Click" ToolTip="{DynamicResource FloatingToggleHint}"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="{DynamicResource LangToggle}" Width="66" Command="{Binding ToggleLanguageCommand}" ToolTip="عربي / English"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click" ToolTip="{DynamicResource WinMin}"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click" ToolTip="{DynamicResource WinClose}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Margin="24,4,24,4" Background="Transparent" FlowDirection="RightToLeft">
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>

            <Border Grid.Row="1" Margin="24,0,24,8" Padding="12,8" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" MaxWidth="620" Style="{StaticResource WarnCard}"
                    Visibility="{Binding HasHotkeyWarning, Converter={StaticResource BoolToVis}}" Panel.ZIndex="12">
                <TextBlock Text="{Binding HotkeyWarning}" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" TextAlignment="Center"/>
            </Border>

            <!-- Floating bottom navigation: no panel or strip behind the capsule. -->
            <Grid Grid.Row="2" Background="Transparent">
                <Border Style="{StaticResource GlassCapsule}" Height="54" CornerRadius="27"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Padding="6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <RadioButton Style="{StaticResource BottomNavItem}" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="home" Content="{DynamicResource NavHome}"/>
                        <RadioButton Style="{StaticResource BottomNavItem}" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="settings" Content="{DynamicResource NavSettings}"/>
                        <RadioButton Style="{StaticResource BottomNavItem}" IsChecked="{Binding IsDiagnostics, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="diag" Content="{DynamicResource NavDiagnostics}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="UpdateBanner" Grid.Row="1" Margin="24,10,24,0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Style="{StaticResource WarnCard}" Visibility="Collapsed" Panel.ZIndex="20">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="{DynamicResource UpdateTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/><TextBlock x:Name="UpdateMessage" Style="{StaticResource Caption}"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UpdateInstallButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource UpdateInstall}" Click="UpdateInstall_Click" Margin="0,0,6,0"/><Button Content="{DynamicResource UpdateLater}" Click="UpdateLater_Click"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
