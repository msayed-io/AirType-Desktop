<Window x:Class="LiveTypeBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirType"
        Width="{DynamicResource Size.WindowWidth}" Height="{DynamicResource Size.WindowHeight}"
        MinWidth="{DynamicResource Size.WindowMinWidth}" MinHeight="{DynamicResource Size.WindowMinHeight}"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        FlowDirection="RightToLeft" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="{StaticResource Radius.XL}" UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource Radius.XL}"
            Margin="{DynamicResource Space.ShellInset}" Effect="{DynamicResource Elevation.Level3}">
        <Grid>
            <Grid Height="{DynamicResource Size.HeaderHeight}" Margin="{DynamicResource Space.Header}"
                  VerticalAlignment="Top" Panel.ZIndex="30" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border Style="{StaticResource ChromeCapsule}" Height="{DynamicResource Size.HeaderHeight}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Padding="{DynamicResource Space.HeaderBrand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="{DynamicResource Size.IconContainer}" Height="{DynamicResource Size.IconContainer}" Margin="0,0,12,0">
                            <Ellipse Fill="{DynamicResource OverlayBrush}"/>
                            <TextBlock Text="⌨" Foreground="{DynamicResource OnDarkBrush}" FontSize="{DynamicResource Type.Heading}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="AirType" FontSize="{DynamicResource Type.Heading}" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource PrivacyTagline}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ChromeCapsule}" Height="{DynamicResource Size.HeaderHeight}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Padding="{DynamicResource Space.HeaderControls}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="8,0"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="◉" Click="FloatingToggle_Click" ToolTip="{DynamicResource FloatingToggleHint}"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="{DynamicResource LangToggle}" Width="{DynamicResource Size.LanguageButton}" Command="{Binding ToggleLanguageCommand}" ToolTip="عربي / English"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="—" Click="Minimize_Click" ToolTip="{DynamicResource WinMin}"/>
                        <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click" ToolTip="{DynamicResource WinClose}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="{DynamicResource Space.ContentHorizontal}" Background="Transparent" FlowDirection="RightToLeft" Panel.ZIndex="0">
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>

            <Border Margin="{DynamicResource Space.Banner}" Padding="{DynamicResource Space.CardCompact}"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="{DynamicResource Size.BannerMaxWidth}"
                    Style="{StaticResource WarnCard}" Visibility="{Binding HasHotkeyWarning, Converter={StaticResource BoolToVis}}" Panel.ZIndex="20">
                <TextBlock Text="{Binding HotkeyWarning}" Style="{StaticResource Caption}" Foreground="{DynamicResource WarnBrush}" TextAlignment="Center"/>
            </Border>

            <Grid Height="{DynamicResource Size.FooterHeight}" VerticalAlignment="Bottom" Panel.ZIndex="30">
                <Border Style="{StaticResource NavCapsule}" Height="{DynamicResource Size.NavHeight}" CornerRadius="{DynamicResource Radius.Nav}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="{DynamicResource Size.NavMaxWidth}" Padding="{DynamicResource Space.Nav}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <RadioButton Style="{StaticResource BottomNavItem}" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="home" Content="{DynamicResource NavHome}"/>
                        <RadioButton Style="{StaticResource BottomNavItem}" IsChecked="{Binding IsSettings, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="settings" Content="{DynamicResource NavSettings}"/>
                        <RadioButton Style="{StaticResource BottomNavItem}" IsChecked="{Binding IsDiagnostics, Mode=OneWay}" Command="{Binding NavCommand}" CommandParameter="diag" Content="{DynamicResource NavDiagnostics}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="UpdateBanner" Margin="{DynamicResource Space.UpdateBanner}" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Style="{StaticResource WarnCard}" Visibility="Collapsed" Panel.ZIndex="40">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0"><TextBlock Text="{DynamicResource UpdateTitle}" Style="{StaticResource H2}" Margin="0,0,0,4"/><TextBlock x:Name="UpdateMessage" Style="{StaticResource Caption}"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UpdateInstallButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource UpdateInstall}" Click="UpdateInstall_Click" Margin="0,0,8,0"/><Button Content="{DynamicResource UpdateLater}" Click="UpdateLater_Click"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
