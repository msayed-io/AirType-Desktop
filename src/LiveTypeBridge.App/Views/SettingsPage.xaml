<UserControl x:Class="LiveTypeBridge.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LiveTypeBridge.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="{DynamicResource Space.PageCompact}">
            <Border Style="{StaticResource HeroCard}" Margin="0,0,0,20" Padding="{DynamicResource Space.CardCompact}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource SetTitle}" Style="{StaticResource H1}" Foreground="{DynamicResource OnAccentBrush}"/>
                        <TextBlock Text="{DynamicResource SetIntro}" Style="{StaticResource Caption}" Foreground="{DynamicResource OnAccentBrush}" Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Content="{DynamicResource SetApply}" Command="{Binding SaveCommand}" MinWidth="{DynamicResource Size.SettingsSaveWidth}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Foreground="{DynamicResource OnAccentBrush}" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="200"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                        <TextBlock Text="{DynamicResource SetConnection}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{DynamicResource SetConnectionHint}" Style="{StaticResource Caption}" Margin="0,-4,0,16"/>
                        <TextBlock Text="{DynamicResource SetPort}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5" FlowDirection="LeftToRight" TextAlignment="Left"/>
                        <TextBlock Text="{DynamicResource SetPortHint}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0"><StackPanel>
                        <TextBlock Text="{DynamicResource SetHotkeys}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{DynamicResource SetHotkeyHint}" Style="{StaticResource Caption}" Margin="0,-4,0,16"/>
                        <TextBlock Text="{DynamicResource SetHkShowApp}" Style="{StaticResource FieldLabel}"/><controls:HotkeyCaptureBox Style="{StaticResource InputBox}" Text="{Binding HkShowApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource SetHkToggle}" Style="{StaticResource FieldLabel}"/><controls:HotkeyCaptureBox Style="{StaticResource InputBox}" Text="{Binding HkToggle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource SetHkQr}" Style="{StaticResource FieldLabel}"/><controls:HotkeyCaptureBox Style="{StaticResource InputBox}" Text="{Binding HkQr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource SetHkEmergency}" Style="{StaticResource FieldLabel}"/><controls:HotkeyCaptureBox Style="{StaticResource InputBox}" Text="{Binding HkEmergency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" TextAlignment="Left"/>
                    </StackPanel></Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SectionCard}"><StackPanel>
                        <TextBlock Text="{DynamicResource SetExperience}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{DynamicResource SetLanguage}" Style="{StaticResource FieldLabel}" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ChoicePill}" Content="{DynamicResource LangArabic}" IsChecked="{Binding LangIsAr, Mode=OneWay}" Command="{Binding SetLangArCommand}" Margin="0,0,8,0"/>
                            <RadioButton Style="{StaticResource ChoicePill}" Content="{DynamicResource LangEnglish}" IsChecked="{Binding LangIsEn, Mode=OneWay}" Command="{Binding SetLangEnCommand}"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,20"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunAtStartup}" Content="{DynamicResource SetStartup}"/>
                        <TextBlock Text="{DynamicResource SetStartupHint}" Style="{StaticResource Caption}" Margin="56,4,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0"><StackPanel>
                        <TextBlock Text="{DynamicResource SetTrustedTitle}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{DynamicResource SetTrustedHint}" Style="{StaticResource Caption}" Margin="0,-4,0,12"/>
                        <TextBlock Text="{Binding TrustedDevicesSummary}" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                        <Button Style="{StaticResource DangerGhostButton}" Content="{DynamicResource SetTrustedForgetAll}"
                                Command="{Binding ForgetTrustedDevicesCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0"><StackPanel>
                        <TextBlock Text="{DynamicResource SetPrivacy}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{DynamicResource SetPrivacyHint}" Style="{StaticResource Caption}" Margin="0,-4,0,16"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableLogging}" Content="{DynamicResource SetLoggingOn}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LogTextContent}" Content="{DynamicResource SetLogContent}" Foreground="{DynamicResource WarnBrush}"/>
                        <Button Content="{DynamicResource SetOpenLogs}" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                    </StackPanel></Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
