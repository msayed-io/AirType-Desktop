<UserControl x:Class="LiveTypeBridge.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LiveTypeBridge.App.Controls">
    <!-- Every existing setting is kept; only the material, spacing and colour change. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel MaxWidth="{DynamicResource Size.ContentMax}" HorizontalAlignment="Center" Margin="{DynamicResource Space.PageCompact}">
            <Grid Margin="0,0,0,20">
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SetTitle}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{DynamicResource SetIntro}" Style="{StaticResource Caption}" Margin="0,6,0,0" MaxWidth="440"/>
                </StackPanel>
                <Button Style="{StaticResource FlatButton}" Content="{DynamicResource SetApply}" Command="{Binding SaveCommand}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetConnection}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource SetConnectionHint}" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                    <TextBlock Text="{DynamicResource SetPort}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"
                             FlowDirection="LeftToRight" TextAlignment="Left" Width="160" HorizontalAlignment="Right"/>
                    <TextBlock Text="{DynamicResource SetPortHint}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetHotkeys}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource SetHotkeyHint}" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                    <TextBlock Text="{DynamicResource SetHkShowApp}" Style="{StaticResource FieldLabel}"/>
                    <controls:HotkeyCaptureBox Style="{StaticResource InputBox}" Text="{Binding HkShowApp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource SetHkToggle}" Style="{StaticResource FieldLabel}"/>
                    <controls:HotkeyCaptureBox Style="{StaticResource InputBox}" Text="{Binding HkToggle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource SetHkQr}" Style="{StaticResource FieldLabel}"/>
                    <controls:HotkeyCaptureBox Style="{StaticResource InputBox}" Text="{Binding HkQr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               FlowDirection="LeftToRight" TextAlignment="Left" Margin="0,0,0,12"/>
                    <TextBlock Text="{DynamicResource SetHkEmergency}" Style="{StaticResource FieldLabel}"/>
                    <controls:HotkeyCaptureBox Style="{StaticResource InputBox}" Text="{Binding HkEmergency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               FlowDirection="LeftToRight" TextAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetExperience}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource SetLanguage}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton Style="{StaticResource ChoicePill}" Content="{DynamicResource LangArabic}" IsChecked="{Binding LangIsAr, Mode=OneWay}"
                                     Command="{Binding SetLangArCommand}" GroupName="LangChoice" Margin="0,0,8,0"/>
                        <RadioButton Style="{StaticResource ChoicePill}" Content="{DynamicResource LangEnglish}" IsChecked="{Binding LangIsEn, Mode=OneWay}"
                                     Command="{Binding SetLangEnCommand}" GroupName="LangChoice"/>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" Margin="0,18,0,18"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunAtStartup}" Content="{DynamicResource SetStartup}"/>
                    <TextBlock Text="{DynamicResource SetStartupHint}" Style="{StaticResource Caption}" Margin="56,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetTrustedTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource SetTrustedHint}" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding TrustedDevicesSummary}" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource FlatDangerButton}" Content="{DynamicResource SetTrustedForgetAll}"
                            Command="{Binding ForgetTrustedDevicesCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetPrivacy}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource SetPrivacyHint}" Style="{StaticResource Caption}" Margin="0,0,0,14"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnableLogging}" Content="{DynamicResource SetLoggingOn}" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LogTextContent}" Content="{DynamicResource SetLogContent}" Foreground="{DynamicResource WarnBrush}"/>
                    <Button Style="{StaticResource FlatButton}" Content="{DynamicResource SetOpenLogs}" Command="{Binding OpenLogsCommand}"
                            HorizontalAlignment="Left" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,16,0,0" TextAlignment="Center"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
