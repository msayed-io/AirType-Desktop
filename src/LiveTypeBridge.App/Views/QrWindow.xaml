<Window x:Class="LiveTypeBridge.App.Views.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource QrTitle}"
        Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="0"
                      CornerRadius="10"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="White" CornerRadius="10" Padding="22,14,22,20">
        <StackPanel>

            <Grid>
                <TextBlock Text="{DynamicResource QrTitle}" FontSize="15" FontWeight="SemiBold"
                           Foreground="#1E2433" VerticalAlignment="Center"/>
                <Button Style="{StaticResource TitleBarButton}" Content="✕"
                        Click="Close_Click" HorizontalAlignment="Right"
                        ToolTip="{DynamicResource QrClose}"/>
            </Grid>

            <TextBlock Text="{DynamicResource QrScanHint}" FontSize="11.5" Foreground="#667085"
                       TextWrapping="Wrap" Margin="0,6,0,12"/>

            <!-- High-contrast QR on pure white -->
            <Border Background="White" Padding="10" CornerRadius="10"
                    BorderBrush="#E3E6F0" BorderThickness="1"
                    HorizontalAlignment="Center">
                <Image Source="{Binding QrImage}" Width="230" Height="230"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <TextBlock Text="{DynamicResource QrPinLabel}" FontSize="12" Foreground="#667085"
                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
            <TextBlock Text="{Binding PinText}" FontSize="38" FontWeight="Bold" FontFamily="Consolas"
                       Foreground="#1E2433" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource QrExpiresIn}" FontSize="11.5" Foreground="#667085"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ExpiresText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E2433"
                           Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Manual entry fallback -->
            <Expander Margin="0,14,0,0" BorderThickness="0">
                <Expander.Header>
                    <TextBlock Text="{DynamicResource QrManual}" FontSize="12" Foreground="#4F46E5"/>
                </Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="{DynamicResource QrAddrLabel}" FontSize="11" Foreground="#667085"/>
                    <TextBox Style="{StaticResource MonoBox}" Text="{Binding AddressText, Mode=OneWay}" Margin="0,2,0,8"/>
                    <TextBlock Text="{DynamicResource QrSidLabel}" FontSize="11" Foreground="#667085"/>
                    <TextBox Style="{StaticResource MonoBox}" Text="{Binding SessionIdText, Mode=OneWay}" Margin="0,2,0,8"/>
                    <TextBlock Text="{DynamicResource QrPinLabel}" FontSize="11" Foreground="#667085"/>
                    <TextBox Style="{StaticResource MonoBox}" Text="{Binding PinText, Mode=OneWay}"/>
                </StackPanel>
            </Expander>

            <Border Background="#FEF3C7" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                <TextBlock Text="{DynamicResource QrFirewallNote}" FontSize="11" Foreground="#92400E"
                           TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </Border>
</Window>
