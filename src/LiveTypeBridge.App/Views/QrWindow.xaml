<Window x:Class="LiveTypeBridge.App.Views.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LiveTypeBridge.App.Controls"
        Title="{DynamicResource QrTitle}" Width="{DynamicResource Size.QrWindow}" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" FlowDirection="RightToLeft" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="{StaticResource Size.HeaderHeight}" ResizeBorderThickness="0" CornerRadius="{StaticResource Radius.XL}" UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BgBrush}" CornerRadius="{DynamicResource Radius.XL}" Padding="{DynamicResource Space.InsetXL}" Effect="{DynamicResource Elevation.Level3}">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="{DynamicResource QrTitle}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{DynamicResource QrScanHint}" Style="{StaticResource Caption}" Margin="0,6,40,0"/>
                </StackPanel>
                <Button Style="{StaticResource TitleBarButton}" Content="✕" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="{DynamicResource QrClose}" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <Border Background="{DynamicResource PureWhiteBrush}" Padding="{DynamicResource Space.InsetS}" CornerRadius="{DynamicResource Radius.M}"
                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="{DynamicResource Stroke.Hairline}"
                    HorizontalAlignment="Center" Margin="0,20,0,0" Effect="{DynamicResource Elevation.Level1}">
                <Image Source="{Binding QrImage}" Width="{DynamicResource Size.Qr}" Height="{DynamicResource Size.Qr}" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <TextBlock Text="{DynamicResource QrPinLabel}" Style="{StaticResource FieldLabel}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="{Binding PinText}" FontSize="{DynamicResource Type.Pin}" FontWeight="Bold" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>

            <controls:PillBorder Background="{DynamicResource AccentBrush}" CornerRadius="{DynamicResource Radius.Pill}" Padding="16,8" HorizontalAlignment="Center" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource QrExpiresIn}" FontSize="{DynamicResource Type.Caption}" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ExpiresText}" FontSize="{DynamicResource Type.Label}" FontWeight="SemiBold" Foreground="{DynamicResource OnAccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </controls:PillBorder>

            <Expander Margin="0,16,0,0" BorderThickness="0">
                <Expander.Header><TextBlock Text="{DynamicResource QrManual}" FontSize="{DynamicResource Type.Label}" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/></Expander.Header>
                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource QrAddrLabel}" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource MonoBox}" Text="{Binding AddressText, Mode=OneWay}" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource QrSidLabel}" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource MonoBox}" Text="{Binding SessionIdText, Mode=OneWay}" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource QrPinLabel}" Style="{StaticResource FieldLabel}"/><TextBox Style="{StaticResource MonoBox}" Text="{Binding PinText, Mode=OneWay}"/>
                    </StackPanel>
                </Border>
            </Expander>

            <Border Style="{StaticResource WarnCard}" Padding="{DynamicResource Space.InsetS}" Margin="0,16,0,0">
                <TextBlock Text="{DynamicResource QrFirewallNote}" FontSize="{DynamicResource Type.Caption}" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" TextTrimming="None"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
