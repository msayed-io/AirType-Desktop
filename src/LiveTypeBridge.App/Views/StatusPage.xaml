<UserControl x:Class="LiveTypeBridge.App.Views.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,12">

            <!-- Status card -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="26" Height="26" VerticalAlignment="Center">
                            <!-- Pulsing halo when connection is healthy -->
                            <Ellipse Width="22" Height="22">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PulseOn}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="PulseStory">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0.35" To="0.02"
                                                                             Duration="0:0:0.9" AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <RemoveStoryboard BeginStoryboardName="PulseStory"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="12" Height="12" Fill="{Binding StateBrush}"/>
                        </Grid>

                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource H1}"/>
                            <TextBlock Text="{Binding StatusSub}" Style="{StaticResource Caption}" MaxWidth="280"/>
                        </StackPanel>
                    </StackPanel>

                    <Separator Margin="0,12" Background="{DynamicResource BorderBrushKey}" Height="1"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="L"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LabelPhone}" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PhoneDisplay}" Style="{StaticResource ValueText}" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LabelLastReceive}" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastReceiveText}" Style="{StaticResource ValueText}" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LabelLatency}" Style="{StaticResource Caption}" Margin="0,0,16,6"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LatencyText}" Style="{StaticResource ValueText}" Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource LabelStats}" Style="{StaticResource Caption}" Margin="0,0,16,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StatsText}" Style="{StaticResource ValueText}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Local-input protection card -->
            <Border Style="{StaticResource WarnCard}" Margin="0,10,0,0"
                    Visibility="{Binding ShowProtectCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ProtectTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarnBrush}"/>
                    <TextBlock Text="{DynamicResource ProtectMsg}" Style="{StaticResource Caption}" Margin="0,6"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource BtnResumeStream}"
                            Command="{Binding ResumeStreamCommand}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Elevated target card -->
            <Border Style="{StaticResource DangerCard}" Margin="0,10,0,0"
                    Visibility="{Binding ShowElevatedCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ElevatedTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="{DynamicResource ElevatedMsg}" Style="{StaticResource Caption}" Margin="0,6"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Button Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Padding="16,11"
                    Content="{DynamicResource BtnPairPhone}"
                    Command="{Binding PairPhoneCommand}"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{Binding StreamButtonLabel}"
                        Command="{Binding ToggleStreamCommand}"
                        IsEnabled="{Binding StreamButtonEnabled}"/>
                <Button Grid.Column="2" Style="{StaticResource DangerGhostButton}"
                        Content="{DynamicResource BtnDisconnect}"
                        Command="{Binding DisconnectCommand}"
                        IsEnabled="{Binding DisconnectEnabled}"/>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
