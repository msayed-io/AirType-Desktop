<UserControl x:Class="LiveTypeBridge.App.Views.StatusPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LiveTypeBridge.App.Controls">
    <!--
        Home screen. Content is centred between the 76 bar and the floating tab bar, stops
        at 640 wide however wide the window gets, and keeps the 112 bottom inset clear of
        the tabs. Every value below is bound to the existing view model; nothing here
        invents data. Four states share this template: not connected, streaming, paused
        and faulted (faults only add the glass toast in the shell).
    -->
    <Grid>
        <StackPanel MaxWidth="{DynamicResource Size.ContentMax}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="{DynamicResource Space.Main}">

            <!-- Status capsule: glass, 32 high, pulsing dot while streaming. -->
            <controls:GlassPill Style="{StaticResource GlassSurfaceStyle}" HorizontalAlignment="Center"
                                Height="{DynamicResource Size.StatusPill}" Padding="{DynamicResource Space.StatusPill}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse Fill="{Binding StateBrush}"/>
                        <Ellipse Fill="{Binding StateBrush}" Opacity="0.75">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PulseDot}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="PulseStory">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.75" To="0.35" Duration="0:0:1.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PulseStory"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding CapsuleText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </controls:GlassPill>

            <TextBlock Text="{Binding HomeTitle}" Style="{StaticResource HeroTitle}" Margin="0,20,0,0"/>
            <TextBlock Text="{Binding HomeSub}" Style="{StaticResource HeroSub}" Margin="0,8,0,0" MaxWidth="640"/>

            <!-- ===== Connected: flat card, device row over three equal metric cells ===== -->
            <Border Style="{StaticResource Card}" Margin="0,36,0,0" Padding="0" MaxWidth="640"
                    Visibility="{Binding ShowSessionCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="{DynamicResource Size.DeviceTile}" Height="{DynamicResource Size.DeviceTile}"
                              Margin="20,18,14,18" VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource SurfaceMutedBrush}"/>
                            <Path Style="{StaticResource Icon}" Data="{StaticResource Ico.Phone}"
                                  Stroke="{DynamicResource TextBrush}" Width="24" Height="24"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,18,20,18">
                            <TextBlock Text="{Binding PhoneDisplay}" Style="{StaticResource DeviceName}"/>
                            <TextBlock Text="{DynamicResource ViaWifi}" Style="{StaticResource DeviceVia}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="20,18,20,20">
                            <TextBlock Text="{DynamicResource HomeLabelLatency}" Style="{StaticResource MetricLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LatencyCellText}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="{DynamicResource UnitMs}" Style="{StaticResource MetricUnit}"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource VDivider}" Margin="0,18,0,20"/>

                        <StackPanel Grid.Column="2" Margin="20,18,20,20">
                            <TextBlock Text="{DynamicResource HomeLabelChars}" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding CharsCellText}" Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                        <Border Grid.Column="3" Style="{StaticResource VDivider}" Margin="0,18,0,20"/>

                        <StackPanel Grid.Column="4" Margin="20,18,20,20">
                            <TextBlock Text="{DynamicResource LabelLastReceive}" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding LastReceiveCellText}" Style="{StaticResource MetricValue}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Not connected: flat card holding the live pairing code ===== -->
            <Border Style="{StaticResource Card}" Margin="0,36,0,0" MaxWidth="640"
                    Visibility="{Binding ShowRefreshCode, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="{DynamicResource Size.Qr}" Height="{DynamicResource Size.Qr}"
                            Background="{DynamicResource PureWhiteBrush}" CornerRadius="{DynamicResource Radius.L}"
                            HorizontalAlignment="Center">
                        <Image Source="{Binding QrVm.QrImage}" Width="168" Height="168" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="16"/>
                    </Border>
                    <TextBlock Text="{Binding QrVm.PinDisplayText}" FontSize="22" FontWeight="Bold" Margin="0,16,0,0"
                               HorizontalAlignment="Center" Language="en-US" Typography.NumeralAlignment="Tabular"/>
                </StackPanel>
            </Border>

            <!-- ===== Actions ===== -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource RefreshCode}"
                        Command="{Binding PairPhoneCommand}"
                        Visibility="{Binding ShowRefreshCode, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource BtnPairPhone}"
                        Command="{Binding PairPhoneCommand}"
                        Visibility="{Binding ShowPairPhone, Converter={StaticResource BoolToVis}}"/>
                <Button Command="{Binding ToggleStreamCommand}" IsEnabled="{Binding StreamButtonEnabled}"
                        Visibility="{Binding ShowSessionCard, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Setter Property="Content" Value="{DynamicResource BtnStopStream}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStreamingNow}" Value="False">
                                    <Setter Property="Content" Value="{DynamicResource BtnResumeStream}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource GlassDangerButton}" Content="{DynamicResource BtnDisconnect}" Margin="12,0,0,0"
                        Command="{Binding DisconnectCommand}" IsEnabled="{Binding DisconnectEnabled}"
                        Visibility="{Binding ShowSessionCard, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Elevated-injection warning: flat card, amber label, no decoration. -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" MaxWidth="640"
                    Visibility="{Binding ShowElevatedCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ElevatedTitle}" FontWeight="SemiBold" Foreground="{DynamicResource WarnBrush}"/>
                    <TextBlock Text="{DynamicResource ElevatedMsg}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
