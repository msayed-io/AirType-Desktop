<Window x:Class="LiveTypeBridge.App.Views.FloatingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="72" Height="72" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Grid x:Name="OrbRoot" Background="Transparent" ToolTip="AirType"
          MouseLeftButtonUp="OrbRoot_MouseLeftButtonUp">
        <Ellipse x:Name="Glow" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#301B8CFF" Opacity="0.8" IsHitTestVisible="False">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1" CenterX="32" CenterY="32"/>
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="58" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Stroke="#805B7CFF" StrokeThickness="1" Opacity="0.75" IsHitTestVisible="False"/>
        <Ellipse x:Name="OrbBody" Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Fill="#171E36" Stroke="#B58CFFFF" StrokeThickness="1.2" IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect Color="#7C5CFF" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
            </Ellipse.Effect>
        </Ellipse>
        <Canvas Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Ellipse Width="5" Height="5" Canvas.Left="20.5" Canvas.Top="5" Fill="#B9F3FF"/>
            <Ellipse Width="4" Height="4" Canvas.Left="8" Canvas.Top="14" Fill="#A98CFF"/>
            <Ellipse Width="5" Height="5" Canvas.Left="33" Canvas.Top="18" Fill="#FF9FD9"/>
            <Ellipse Width="4" Height="4" Canvas.Left="12" Canvas.Top="31" Fill="#6EE7FF"/>
            <Ellipse Width="5" Height="5" Canvas.Left="28" Canvas.Top="34" Fill="#C8B5FF"/>
            <Ellipse Width="3" Height="3" Canvas.Left="22" Canvas.Top="21" Fill="White"/>
        </Canvas>
    </Grid>
</Window>
