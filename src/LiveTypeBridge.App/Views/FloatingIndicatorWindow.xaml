<Window x:Class="LiveTypeBridge.App.Views.FloatingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="76" Height="76" WindowStyle="None" AllowsTransparency="False" Background="#101522"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Border CornerRadius="38" Background="#101522" BorderBrush="#607B8CFF" BorderThickness="1" Padding="3" ToolTip="AirType">
      <Grid x:Name="OrbRoot" Background="Transparent">
        <wv2:WebView2 x:Name="OrbWebView"/>
        <Border x:Name="FallbackOrb" Visibility="Collapsed" CornerRadius="34" Margin="2" Background="{DynamicResource OrbGradient}" BorderBrush="#99FFFFFF" BorderThickness="1">
            <TextBlock Text="A" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </Border>
</Window>
