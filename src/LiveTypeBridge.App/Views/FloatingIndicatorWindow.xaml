<Window x:Class="LiveTypeBridge.App.Views.FloatingIndicatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="92" Height="92" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Grid x:Name="OrbRoot" Background="Transparent" ToolTip="AirType">
        <wv2:WebView2 x:Name="OrbWebView"/>
        <Border x:Name="FallbackOrb" Visibility="Collapsed" CornerRadius="46" Margin="10" Background="{DynamicResource OrbGradient}" BorderBrush="#99FFFFFF" BorderThickness="1">
            <TextBlock Text="A" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
