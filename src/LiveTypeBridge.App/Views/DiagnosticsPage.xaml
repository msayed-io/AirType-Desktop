<UserControl x:Class="LiveTypeBridge.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Diagnostics tab: one title, one flat card, label at the start of the row and the
        value at the end. This is the only place where the technical details live; the home
        screen shows three short values and nothing else.
    -->
    <UserControl.Resources>
        <Style x:Key="DiagRow" TargetType="Grid">
            <Setter Property="Margin" Value="20,14,20,14"/>
        </Style>
        <Style x:Key="DiagLabel" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DiagValue" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="360"/>
        </Style>
        <Style x:Key="DiagNumber" TargetType="TextBlock" BasedOn="{StaticResource DiagValue}">
            <Setter Property="Language" Value="en-US"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel MaxWidth="{DynamicResource Size.ContentMax}" HorizontalAlignment="Center" Margin="{DynamicResource Space.Page}">

            <TextBlock Text="{DynamicResource DiagTitle}" Style="{StaticResource H1}" HorizontalAlignment="Right" Margin="0,0,0,20"/>

            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LabelOps}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding OpsCellText}" Style="{StaticResource DiagNumber}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LabelChars}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CharsCellText}" Style="{StaticResource DiagNumber}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LabelBackspaces}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding BackspacesCellText}" Style="{StaticResource DiagNumber}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LabelInjectMs}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding InjectCellText}" Style="{StaticResource DiagNumber}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LabelLastMessage}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding LastMessageCellText}" Style="{StaticResource DiagNumber}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LabelRtt}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RttCellText}" Style="{StaticResource DiagNumber}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource LabelLastReceive}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding LastReceiveCellText}" Style="{StaticResource DiagNumber}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource DiagWs}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding WsText}" Style="{StaticResource DiagValue}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource DiagUptime}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding UptimeText}" Style="{StaticResource DiagValue}" FontFamily="{DynamicResource Font.Mono}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource DiagPort}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PortText}" Style="{StaticResource DiagNumber}" FlowDirection="LeftToRight"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource DiagIp}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding IpText}" Style="{StaticResource DiagValue}"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Caption}" FlowDirection="LeftToRight"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource DiagFw}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding FirewallText}" Style="{StaticResource DiagValue}"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>

                    <Grid Style="{StaticResource DiagRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource DiagErr}" Style="{StaticResource DiagLabel}"/>
                        <TextBlock Grid.Column="1" Text="{Binding LastErrorText}" Style="{StaticResource DiagValue}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Style="{StaticResource FlatButton}" Content="{DynamicResource DiagRefresh}" Command="{Binding RefreshCommand}"/>
                <Button Style="{StaticResource FlatButton}" Content="{DynamicResource DiagRunTest}" Command="{Binding RunSelfTestCommand}" Margin="12,0,0,0"/>
            </StackPanel>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding HasSelfTestOutput, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DiagSelfTest}" Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                    <ScrollViewer Height="{DynamicResource Size.ConsoleHeight}" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding SelfTestOutput, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="{DynamicResource Type.Caption}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Left" FlowDirection="LeftToRight"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
