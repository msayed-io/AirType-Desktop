<UserControl x:Class="LiveTypeBridge.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="4,8,4,28">
            <Grid Margin="4,0,4,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource DiagTitle}" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{DynamicResource DiagIntro}" Style="{StaticResource Caption}" Margin="0,5,0,0" MaxWidth="520" HorizontalAlignment="Left"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource DiagRefresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" MinWidth="104" Margin="18,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource HeroCard}" Padding="20" MinHeight="108">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="46" Height="46" VerticalAlignment="Center">
                        <Ellipse Fill="#30FFFFFF"/>
                        <Ellipse Width="14" Height="14" Fill="{DynamicResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="{DynamicResource DiagWs}" FontSize="11" Foreground="#D9D4FF"/>
                        <TextBlock Text="{Binding WsText}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="92">
                        <TextBlock Text="{DynamicResource DiagUptime}" FontSize="11" Foreground="#D9D4FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding UptimeText}" FontSize="17" FontWeight="SemiBold" Foreground="White" FontFamily="Cascadia Mono, Consolas" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DiagNetwork}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{DynamicResource DiagIp}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding IpText}" Style="{StaticResource MetricValue}" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" FlowDirection="LeftToRight" TextAlignment="Left"/>
                        <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,15"/>
                        <TextBlock Text="{DynamicResource DiagPort}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding PortText}" Style="{StaticResource MetricValue}" FontFamily="Cascadia Mono, Consolas" FlowDirection="LeftToRight" TextAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource DiagProtection}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{DynamicResource DiagFw}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding FirewallText}" Style="{StaticResource MetricValue}" FontSize="13" TextWrapping="Wrap"/>
                        <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,15"/>
                        <TextBlock Text="{DynamicResource DiagErr}" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding LastErrorText}" Style="{StaticResource MetricValue}" FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource SectionCard}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource DiagSelfTest}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{DynamicResource DiagTestHint}" Style="{StaticResource Caption}" Margin="0,-4,12,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource DiagRunTest}" Command="{Binding RunSelfTestCommand}" VerticalAlignment="Center" MinWidth="142"/>
                    </Grid>

                    <Border Background="#D9080D1A" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" CornerRadius="13" Margin="0,15,0,0" Padding="12">
                        <TextBox Text="{Binding SelfTestOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                 Height="176" Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="#C9F5D2" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                 TextWrapping="Wrap" TextAlignment="Left" FlowDirection="LeftToRight"
                                 VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
