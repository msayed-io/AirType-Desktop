<UserControl x:Class="LiveTypeBridge.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,12">

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource DiagIp}" Style="{StaticResource Caption}" Margin="0,0,10,6"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IpText}" Style="{StaticResource ValueText}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource DiagPort}" Style="{StaticResource Caption}" Margin="0,0,10,6"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PortText}" Style="{StaticResource ValueText}" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource DiagWs}" Style="{StaticResource Caption}" Margin="0,0,10,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WsText}" Style="{StaticResource ValueText}" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource DiagUptime}" Style="{StaticResource Caption}" Margin="0,0,10,6"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding UptimeText}" Style="{StaticResource ValueText}" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource DiagFw}" Style="{StaticResource Caption}" Margin="0,0,10,6"
                               VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FirewallText}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource DiagErr}" Style="{StaticResource Caption}" Margin="0,0,10,0"
                               VerticalAlignment="Top"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastErrorText}" Style="{StaticResource Caption}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource DiagSelfTest}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource DiagTestHint}" Style="{StaticResource Caption}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="{DynamicResource DiagRunTest}"
                                Command="{Binding RunSelfTestCommand}"/>
                        <Button Content="{DynamicResource DiagRefresh}" Margin="8,0,0,0"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                    <TextBox Style="{StaticResource MonoBox}" Margin="0,10,0,0" Height="220"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Text="{Binding SelfTestOutput, Mode=OneWay}"
                             TextAlignment="Left" FlowDirection="LeftToRight"
                             IsReadOnly="True" Background="#0B1020" Foreground="#C9F5D2"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
