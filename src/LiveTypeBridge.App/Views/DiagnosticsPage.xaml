<UserControl x:Class="LiveTypeBridge.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LiveTypeBridge.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel Margin="{DynamicResource Space.PageCompact}">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource DiagTitle}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{DynamicResource DiagIntro}" Style="{StaticResource Caption}" Margin="0,6,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{DynamicResource DiagRefresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" MinWidth="{DynamicResource Size.ActionMinWidth}" Margin="20,0,0,0"/>
            </Grid>

            <Border Style="{StaticResource HeroCard}" MinHeight="112">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="{DynamicResource Size.TouchTarget}" Height="{DynamicResource Size.TouchTarget}" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource OverlayBrush}"/>
                        <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="{DynamicResource DiagWs}" FontSize="{DynamicResource Type.Caption}" Foreground="{DynamicResource OnAccentBrush}"/>
                        <TextBlock Text="{Binding WsText}" FontSize="{DynamicResource Type.Heading}" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"/>
                    </StackPanel>
                    <controls:PillBorder Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource Radius.Pill}" Padding="16,10" VerticalAlignment="Center" MinWidth="104">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DiagUptime}" FontSize="{DynamicResource Type.Caption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding UptimeText}" FontSize="{DynamicResource Type.Heading}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource Font.Mono}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </controls:PillBorder>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource SectionCard}"><StackPanel>
                    <TextBlock Text="{DynamicResource DiagNetwork}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource DiagIp}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding IpText}" Style="{StaticResource MetricValue}" FontFamily="{DynamicResource Font.Mono}" TextWrapping="Wrap" FlowDirection="LeftToRight" TextAlignment="Left"/>
                    <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,16"/>
                    <TextBlock Text="{DynamicResource DiagPort}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding PortText}" Style="{StaticResource MetricValue}" FontFamily="{DynamicResource Font.Mono}" FlowDirection="LeftToRight" TextAlignment="Left"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource SectionCard}"><StackPanel>
                    <TextBlock Text="{DynamicResource DiagProtection}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{DynamicResource DiagFw}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding FirewallText}" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                    <Border Height="1" Background="{DynamicResource BorderBrushKey}" Margin="0,16"/>
                    <TextBlock Text="{DynamicResource DiagErr}" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding LastErrorText}" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                </StackPanel></Border>
            </Grid>

            <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="{DynamicResource DiagSelfTest}" Style="{StaticResource H2}"/><TextBlock Text="{DynamicResource DiagTestHint}" Style="{StaticResource Caption}" Margin="0,-4,16,0"/></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource DiagRunTest}" Command="{Binding RunSelfTestCommand}" VerticalAlignment="Center" MinWidth="{DynamicResource Size.SelfTestWidth}"/>
                    </Grid>
                    <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="{DynamicResource Stroke.Hairline}" CornerRadius="{DynamicResource Radius.Input}" Margin="0,16,0,0" Padding="{DynamicResource Space.InsetS}">
                        <TextBox Text="{Binding SelfTestOutput, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="{DynamicResource Size.ConsoleHeight}"
                                 Background="Transparent" BorderThickness="{DynamicResource Stroke.None}" Padding="{DynamicResource Space.Zero}"
                                 Foreground="{DynamicResource OnAccentBrush}" FontFamily="{DynamicResource Font.Mono}" FontSize="{DynamicResource Type.Caption}"
                                 TextWrapping="Wrap" TextAlignment="Left" FlowDirection="LeftToRight" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
