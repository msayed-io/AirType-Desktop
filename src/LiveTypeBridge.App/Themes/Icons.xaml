<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Icon geometry, copied command-for-command from the SVG symbols in
        airtype-desktop.html (#i-sliders, #i-phone, #i-home, #i-pulse, #i-min, #i-max,
        #i-close). Each entry is a 24x24 outline drawn with a 1.75 stroke, round caps
        and round joins - the same weight as the reference.
    -->
    <GeometryGroup x:Key="Ico.Phone">
        <RectangleGeometry Rect="7,2.5,10,19" RadiusX="2.8" RadiusY="2.8"/>
        <PathGeometry Figures="M10.5,18.5 L13.5,18.5"/>
    </GeometryGroup>

    <GeometryGroup x:Key="Ico.Sliders">
        <PathGeometry Figures="M4,7 L13,7 M17,7 L20,7 M4,17 L7,17 M11,17 L20,17"/>
        <EllipseGeometry Center="15,7" RadiusX="2" RadiusY="2"/>
        <EllipseGeometry Center="9,17" RadiusX="2" RadiusY="2"/>
    </GeometryGroup>

    <PathGeometry x:Key="Ico.Home" Figures="M4,11 L12,4.5 L20,11 L20,19 A1,1 0 0 1 19,20 L14.5,20 L14.5,14.5 L9.5,14.5 L9.5,20 L5,20 A1,1 0 0 1 4,19 Z"/>
    <PathGeometry x:Key="Ico.Pulse" Figures="M3,12 L7,12 L10,5 L14,19 L17,12 L21,12"/>
    <PathGeometry x:Key="Ico.Minimize" Figures="M5,12 L19,12"/>
    <RectangleGeometry x:Key="Ico.Maximize" Rect="5.5,5.5,13,13" RadiusX="2.5" RadiusY="2.5"/>
    <PathGeometry x:Key="Ico.Close" Figures="M6,6 L18,18 M18,6 L6,18"/>
</ResourceDictionary>
