<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LiveTypeBridge.App.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Themes/DesignTokens.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Themes/Glass.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ============ Typography ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Arabic}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>
    <Style x:Key="BaseText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    <Style x:Key="Wordmark" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Wordmark}"/><Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/>
    </Style>
    <Style x:Key="HeroTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Hero}"/><Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="39"/><Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="HeroSub" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Sub}"/><Setter Property="LineHeight" Value="25"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Display}"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Heading}"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,4,0,12"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/><Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Metric cell: 13 label over a 28 tabular number, exactly as in the card. -->
    <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Metric}"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,6,0,0"/><Setter Property="Language" Value="en-US"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="MetricUnit" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Button}"/><Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style x:Key="DeviceName" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Sub}"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FlowDirection" Value="LeftToRight"/><Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>
    <Style x:Key="DeviceVia" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ============ Surfaces: flat only ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="WarnCard" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="DangerCard" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="0.5"/><Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
    </Style>
    <Style x:Key="VDivider" TargetType="Border">
        <Setter Property="Width" Value="0.5"/><Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
    </Style>

    <!-- ============ Glass: the six permitted elements ============ -->
    <Style x:Key="GlassSurfaceStyle" TargetType="controls:GlassPill">
        <Setter Property="Fill" Value="{DynamicResource Glass.Fill}"/>
        <Setter Property="RimBrush" Value="{DynamicResource Glass.Spec}"/>
        <Setter Property="RimThickness" Value="{DynamicResource Stroke.Rim}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}"/>
        <Setter Property="Effect" Value="{DynamicResource Elevation.Glass}"/>
    </Style>

    <!-- Navigation container: solid dark surface, no fill gradient and no specular rim.
         The pill shape and the selected-tab indicator stay exactly as they were. -->
    <Style x:Key="NavSurfaceStyle" TargetType="controls:PillBorder">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Navigation}"/>
    </Style>

    <!-- Action button: 44 high, 26 side padding, 15/600, glass pill. -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Arabic}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Button}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Height" Value="{DynamicResource Size.ControlHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Button}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <controls:GlassPill x:Name="Surface" Style="{StaticResource GlassSurfaceStyle}"
                                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <controls:GlassPill.RenderTransform>
                                <ScaleTransform/>
                            </controls:GlassPill.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </controls:GlassPill>
                        <controls:PillBorder x:Name="FocusRing" CornerRadius="{DynamicResource Radius.Pill}"
                                             BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2"
                                             Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Fill" Value="{DynamicResource Glass.FillHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Fill" Value="{DynamicResource Glass.FillPressed}"/>
                            <Setter TargetName="Surface" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Glass, red label, no red fill: the disconnect capsule of the connected screen. -->
    <Style x:Key="GlassDangerButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>

    <!-- Flat button: used everywhere glass is NOT allowed (settings, diagnostics).
         44 high, 26 side padding, 15/600, same press scale, no specular rim. -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Arabic}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Button}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="Height" Value="{DynamicResource Size.ControlHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Button}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <controls:PillBorder x:Name="Surface" CornerRadius="{DynamicResource Radius.Pill}"
                                             Background="{DynamicResource SurfaceMutedBrush}" Padding="{TemplateBinding Padding}"
                                             RenderTransformOrigin="0.5,0.5">
                            <controls:PillBorder.RenderTransform><ScaleTransform/></controls:PillBorder.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </controls:PillBorder>
                        <controls:PillBorder x:Name="FocusRing" CornerRadius="{DynamicResource Radius.Pill}"
                                             BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2"
                                             Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource OverlayPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FlatDangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}"/>

    <!-- Default button: flat, so a Button that forgets its style is never glass. -->
    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}"/>

    <!-- Backwards-compatible aliases: the glass capsule is the default "ghost" action. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource GlassButton}"/>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GlassDangerButton}"/>
    <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource FlatDangerButton}"/>

    <!-- Window caption buttons: 36 round, transparent until hovered. -->
    <Style x:Key="TitleBarButton" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource Size.CaptionButton}"/>
        <Setter Property="Height" Value="{DynamicResource Size.CaptionButton}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bg" CornerRadius="18" Background="Transparent"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="FocusRing" CornerRadius="18" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="2" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource PureWhiteBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bottom tab: selected = 14% white background (no rim) + blue label. -->
    <Style x:Key="BottomNavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Arabic}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Button}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="{DynamicResource Size.TabHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Tab}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <controls:PillBorder x:Name="Surface" CornerRadius="{DynamicResource Radius.Pill}" Background="Transparent"
                                             Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </controls:PillBorder>
                        <controls:PillBorder x:Name="FocusRing" CornerRadius="{DynamicResource Radius.Pill}"
                                             BorderBrush="{DynamicResource FocusRingBrush}"
                                             BorderThickness="2" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChoicePill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Arabic}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Label}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Button}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <controls:PillBorder x:Name="Surface" CornerRadius="{DynamicResource Radius.Pill}"
                                             Background="{DynamicResource SurfaceMutedBrush}"
                                             Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </controls:PillBorder>
                        <controls:PillBorder x:Name="FocusRing" CornerRadius="{DynamicResource Radius.Pill}"
                                             BorderBrush="{DynamicResource FocusRingBrush}"
                                             BorderThickness="2" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#33FFFFFF"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Inputs ============ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Arabic}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Input}"/>
        <Setter Property="MinHeight" Value="{DynamicResource Size.ControlHeight}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Surface" CornerRadius="{DynamicResource Radius.Input}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="{DynamicResource Radius.Input}" BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="2" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="{DynamicResource Opacity.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MonoBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Label}"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- Toggle switch: 44x24 track, white thumb, green when on. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Arabic}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="44" Height="24" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="12" Background="{DynamicResource SurfaceMutedBrush}"/>
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource PureWhiteBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Icon helpers ============ -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.75"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Width" Value="{DynamicResource Size.Icon}"/>
        <Setter Property="Height" Value="{DynamicResource Size.Icon}"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>
</ResourceDictionary>
