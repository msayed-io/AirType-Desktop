<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:LiveTypeBridge.App.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Themes/DesignTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Typography -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Latin}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="BaseText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"/>
    <Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Title}"/><Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Heading}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/><Setter Property="Margin" Value="0,4,0,12"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Caption}"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="None"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="TextTrimming" Value="None"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Label}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource ValueText}">
        <Setter Property="FontSize" Value="{DynamicResource Type.Heading}"/><Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Hairline}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.L}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Card}"/>
        <Setter Property="Effect" Value="{DynamicResource Elevation.Level1}"/>
    </Style>
    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}"/>
    <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource HeroGradient}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="Effect" Value="{DynamicResource Elevation.Level2}"/>
    </Style>
    <Style x:Key="WarnCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
    </Style>
    <Style x:Key="DangerCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource TertiaryBrush}"/>
    </Style>
    <Style x:Key="ChromeCapsule" TargetType="controls:SmoothBorder">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Hairline}"/><Setter Property="CornerRadius" Value="{DynamicResource Radius.Header}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Nav}"/><Setter Property="Effect" Value="{DynamicResource Elevation.Level1}"/>
    </Style>
    <Style x:Key="NavCapsule" TargetType="controls:SmoothBorder" BasedOn="{StaticResource ChromeCapsule}">
        <Setter Property="Background" Value="{DynamicResource CardRaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/><Setter Property="Effect" Value="{DynamicResource Elevation.Level2}"/>
    </Style>
    <Style x:Key="GlassCapsule" TargetType="controls:SmoothBorder" BasedOn="{StaticResource ChromeCapsule}"/>

    <!-- Buttons -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Latin}"/><Setter Property="FontSize" Value="{DynamicResource Type.Body}"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource CardRaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource Stroke.Hairline}"/><Setter Property="Padding" Value="{DynamicResource Space.Button}"/><Setter Property="MinHeight" Value="{DynamicResource Size.ControlHeight}"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="Button">
                <controls:SmoothBorder x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Control}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False"/>
                </controls:SmoothBorder>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/><Setter TargetName="ButtonSurface" Property="Opacity" Value="{DynamicResource Opacity.Hover}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="{DynamicResource Stroke.Focus}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource AccentPressedBrush}"/><Setter TargetName="ButtonSurface" Property="Opacity" Value="{DynamicResource Opacity.Pressed}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="{DynamicResource Opacity.Disabled}"/><Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/><Setter Property="Effect" Value="{DynamicResource Elevation.Level1}"/>
    </Style>
    <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
    </Style>
    <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="{DynamicResource Size.TitleButton}"/><Setter Property="Height" Value="{DynamicResource Size.TitleButton}"/><Setter Property="MinHeight" Value="{DynamicResource Size.TitleButton}"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="{DynamicResource Stroke.None}"/><Setter Property="Padding" Value="{DynamicResource Space.InsetXXS}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Latin}"/><Setter Property="FontSize" Value="{DynamicResource Type.Body}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/><Setter Property="BorderThickness" Value="{DynamicResource Stroke.Hairline}"/><Setter Property="Padding" Value="{DynamicResource Space.Input}"/><Setter Property="MinHeight" Value="{DynamicResource Size.ControlHeight}"/>
    </Style>
    <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <controls:SmoothBorder x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.Control}">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </controls:SmoothBorder>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="InputSurface" Property="BorderThickness" Value="{DynamicResource Stroke.Focus}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputSurface" Property="Opacity" Value="{DynamicResource Opacity.Disabled}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MonoBox" TargetType="TextBox" BasedOn="{StaticResource InputBox}"><Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/><Setter Property="FontSize" Value="{DynamicResource Type.Label}"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>

    <!-- Selection and navigation -->
    <Style x:Key="BottomNavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Latin}"/><Setter Property="FontSize" Value="{DynamicResource Type.Label}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="{DynamicResource Size.ControlHeight}"/><Setter Property="Padding" Value="{DynamicResource Space.Button}"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <controls:SmoothBorder x:Name="NavSurface" Background="Transparent" CornerRadius="{DynamicResource Radius.Control}" Padding="{TemplateBinding Padding}" BorderThickness="{DynamicResource Stroke.Hairline}" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></controls:SmoothBorder>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ChoicePill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontFamily" Value="{DynamicResource Font.Latin}"/><Setter Property="FontSize" Value="{DynamicResource Type.Label}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="{DynamicResource Space.Button}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <controls:SmoothBorder x:Name="ChoiceSurface" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="{DynamicResource Stroke.Hairline}" CornerRadius="{DynamicResource Radius.Control}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></controls:SmoothBorder>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="{DynamicResource Font.Latin}"/><Setter Property="FontSize" Value="{DynamicResource Type.Label}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <controls:SmoothBorder x:Name="Track" Grid.Column="0" Width="44" Height="24" CornerRadius="{DynamicResource Radius.Toggle}" Background="{DynamicResource SurfaceMutedBrush}" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="{DynamicResource Stroke.Hairline}" VerticalAlignment="Center"><controls:SmoothBorder x:Name="Thumb" Width="18" Height="18" CornerRadius="{DynamicResource Radius.ToggleThumb}" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" Margin="2"/></controls:SmoothBorder>
                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Background" Value="{DynamicResource OnAccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource OverlayBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
