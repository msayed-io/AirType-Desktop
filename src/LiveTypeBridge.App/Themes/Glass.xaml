<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/Themes/DesignTokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--
        The one glass material. Copied from airtype-desktop.html:
          fill: linear-gradient(180deg, rgba(255,255,255,.14), rgba(255,255,255,.07))
          spec: linear-gradient(135deg, twelve white stops)
          rim:  .75px (1px at 2x, .667px at 3x - see RimThickness, which is a DIP count)
        Only the six glass elements in the design use these brushes.
    -->
    <LinearGradientBrush x:Key="Glass.Fill" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Glass.FillHover" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#2EFFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Glass.FillPressed" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#1CFFFFFF" Offset="0"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- 12 stops, light from the top-left corner and a softer reflection bottom-right. -->
    <LinearGradientBrush x:Key="Glass.Spec" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9EFFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.06"/>
        <GradientStop Color="#57FFFFFF" Offset="0.13"/>
        <GradientStop Color="#30FFFFFF" Offset="0.21"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.30"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.40"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.50"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.60"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.70"/>
        <GradientStop Color="#2EFFFFFF" Offset="0.80"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.90"/>
        <GradientStop Color="#70FFFFFF" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
