<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Reference-sampled warm editorial palette. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#C3C3C3"/>
    <SolidColorBrush x:Key="BgBrush" Color="#EBEAE8"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#F2F0F1"/>
    <SolidColorBrush x:Key="CardBrush" Color="#F7F6F4"/>
    <SolidColorBrush x:Key="CardRaisedBrush" Color="#F2F0F1"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#E1E0DE"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#EBEAE8"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#232323"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="#A9AAA8"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FDFCF9"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#82A0CF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7595C7"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6888BB"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DDE6F3"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#E4C75F"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="#E66B54"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#82A0CF"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#DDE6F3"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#E66B54"/>

    <SolidColorBrush x:Key="TextBrush" Color="#292929"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666866"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#747674"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#8A8C89"/>
    <SolidColorBrush x:Key="OnDarkBrush" Color="#F7F6F4"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#202733"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#587D68"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DFEAE2"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#8A6818"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#F3E9C5"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#9E4037"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F3DDDA"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#49698F"/>
    <SolidColorBrush x:Key="IdleBrush" Color="#747674"/>
    <SolidColorBrush x:Key="IdleSoftBrush" Color="#E1E0DE"/>

    <SolidColorBrush x:Key="GlassBrush" Color="#F5F2F0F1"/>
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="PureWhiteBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PureBlackBrush" Color="#000000"/>

    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#7595C7" Offset="0"/>
        <GradientStop Color="#82A0CF" Offset="0.48"/>
        <GradientStop Color="#9BB4DF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrbGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#82A0CF" Offset="0"/>
        <GradientStop Color="#E4C75F" Offset="0.62"/>
        <GradientStop Color="#E66B54" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
