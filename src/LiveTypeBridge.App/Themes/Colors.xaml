<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Quiet, modern light palette -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FB"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="#E3E6F0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1E2433"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#667085"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="IdleBrush" Color="#98A2B3"/>
    <SolidColorBrush x:Key="IdleSoftBrush" Color="#F2F4F7"/>
    <SolidColorBrush x:Key="ShadowColor" Color="#33101828"/>
</ResourceDictionary>
