<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        AirType dark palette - the only colour system in the app.
        Values are copied from airtype-desktop.html (:root) and never invented here.
        Glass is a material (see Themes/Glass.xaml), not a colour: everything that is
        not one of the six glass elements stays on these flat surfaces.
    -->
    <Color x:Key="Color.Bg">#FF000000</Color>
    <Color x:Key="Color.Surface">#FF1C1C1E</Color>
    <Color x:Key="Color.Surface2">#FF2C2C2E</Color>
    <Color x:Key="Color.Sep">#73545458</Color>
    <Color x:Key="Color.Label">#FFFFFFFF</Color>
    <Color x:Key="Color.Label2">#9EEBEBF5</Color>
    <Color x:Key="Color.Label3">#52EBEBF5</Color>
    <Color x:Key="Color.Blue">#FF0A84FF</Color>
    <Color x:Key="Color.Green">#FF30D158</Color>
    <Color x:Key="Color.Red">#FFFF453A</Color>
    <Color x:Key="Color.Amber">#FFFFD60A</Color>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#73545458"/>
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#24FFFFFF"/>

    <!-- Legacy surface names still referenced by the remaining views. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="CardRaisedBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="OverlayPressedBrush" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="BorderBrushKey" Color="#73545458"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1FFFFFFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9EEBEBF5"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9EEBEBF5"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#52EBEBF5"/>
    <SolidColorBrush x:Key="OnDarkBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFFFF"/>

    <!-- Accents: blue is reserved for the selected tab, green for the connection,
         red for the destructive action, amber for "ready to pair". -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#240A84FF"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="#FFFF453A"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="CyanSoftBrush" Color="#240A84FF"/>
    <SolidColorBrush x:Key="PinkBrush" Color="#FFFF453A"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#FF30D158"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2430D158"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FFFFD60A"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#24FFD60A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#24FF453A"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="IdleBrush" Color="#8E8E93"/>
    <SolidColorBrush x:Key="IdleSoftBrush" Color="#1FFFFFFF"/>

    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000"/>
    <SolidColorBrush x:Key="PureWhiteBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PureBlackBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FF0A84FF"/>

    <!-- Neutral, colourless fill kept for the floating pill indicator, which is not part of
         the reference screens but is still part of the app. No coloured gradient. -->
    <LinearGradientBrush x:Key="HeroGradient" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#FF2C2C2E" Offset="0"/>
        <GradientStop Color="#FF1C1C1E" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
